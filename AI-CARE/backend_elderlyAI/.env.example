# ==============================================================================
# ELDERLYCARE AI — ENVIRONMENT CONFIGURATION TEMPLATE (.ENV.EXAMPLE)
# ==============================================================================
# Sao chép tập tin này thành .env và điền các giá trị bảo mật trước khi chạy.
# KHÔNG commit tập tin .env chứa thông tin bí mật lên Git repository!
# ==============================================================================

# Cấu hình Máy chủ Flask
FLASK_ENV=development
DEBUG=False
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# Khóa bí mật JWT & Phiên bảo mật (Tối thiểu 32 ký tự ngẫu nhiên)
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-secret-key-2026
JWT_SECRET_KEY=change-this-to-a-very-secure-random-32-byte-secret-key-2026

# Cấu hình Cơ sở dữ liệu MySQL / MariaDB
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ElderlyCareAI
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:your_mysql_password_here@localhost:3306/ElderlyCareAI

# Cấu hình CORS Domain Frontend được phép truy cập
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Cấu hình Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
