# ==============================================================================
# ELDERLYCARE AI - MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.ENV.EXAMPLE)
# Sao chép file này thành .env trong thư mục backend_elderlyAI:
#   cp .env.example .env
# ==============================================================================

# 1. Cấu hình CSDL MySQL / MariaDB (Nếu không cấu hình, hệ thống tự động dùng SQLite an toàn)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ElderlyCareAI

# URI kết nối trực tiếp (Tùy chọn ghi đè, vd: sqlite:///instance/elderly_ai.db hoặc mysql+pymysql://root:@localhost/ElderlyCareAI)
# SQLALCHEMY_DATABASE_URI=sqlite:///instance/elderly_ai.db

# 2. Cấu hình Khóa Bảo Mật JWT & Session Server-side
SECRET_KEY=elderly_ai_secret_key_jwt_secure_2026_salt_32bytes
JWT_SECRET_KEY=elderly_ai_secret_key_jwt_secure_2026_salt_32bytes

# 3. Cấu hình Google Gemini AI API (Lấy API Key miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# 4. Cấu hình Server Flask & CORS Origins
FLASK_ENV=production
DEBUG=False
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
